{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/feed/xataka",
      "destination": "https://www.xataka.com/feedburner.xml"
    },
    {
      "source": "/feed/adslzone",
      "destination": "https://feeds.feedburner.com/adslzone/adslzone"
    },
    {
      "source": "/feed/genbeta",
      "destination": "https://www.genbeta.com/feedburner.xml"
    },
    {
      "source": "/feed/eldia",
      "destination": "https://www.eldia.es/rss/"
    },
    {
      "source": "/feed/muylinux",
      "destination": "https://www.muylinux.com/feed/"
    },
    {
      "source": "/feed/bandaancha",
      "destination": "https://bandaancha.eu/articulos.rss"
    },
    {
      "source": "/feed/elespanol",
      "destination": "https://www.elespanol.com/rss/"
    },
    {
      "source": "/feed/diariodeavisos",
      "destination": "https://diariodeavisos.elespanol.com/feed/"
    },
    {
      "source": "/feed/midudev",
      "destination": "https://nitter.mizuki.st/midudev/rss"
    },
    {
      "source": "/feed/dotcsv",
      "destination": "https://nitter.mizuki.st/DotCSV/rss"
    },
    {
      "source": "/feed/llmmaster",
      "destination": "https://nitter.mizuki.st/llmmaster/rss"
    },
    {
      "source": "/feed/elhacker",
      "destination": "https://blog.elhacker.net/feeds/posts/default"
    },
    {
      "source": "/elhacker/:path*",
      "destination": "https://blog.elhacker.net/:path*"
    }
  ]
}
